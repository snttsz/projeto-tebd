digraph G { layout=neato; splines=line; overlap=true; pad=0.4;
graph [fontname="Segoe UI", bgcolor="#FFFFFF", pad=0.4, labelloc=t, labeljust=l, fontsize=15, fontcolor="#12343B"];
node [shape=plaintext, fontname="Segoe UI"];
edge [fontname="Segoe UI"];
label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#12343B"><B>Subárea A · Planejamento e execução da coleta</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4A5B5F">Quem coleta, com qual veículo, em qual rota e em qual dia. Cada execução de uma rota é uma linha de coleta.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F"><B>PK</B> chave primária  ·  <B>FK</B> chave estrangeira  ·  ? aceita NULL  ·  tracejado = atalho de outra subárea  ·  1 ‖ ○&lt; = um para zero ou muitos  ·  ‖○ = FK opcional</FONT></TD></TR></TABLE>>; labelloc=t; labeljust=l;
"atalho.bairro" [label=<<TABLE BORDER="1" COLOR="#B45309" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="3" BGCOLOR="#FFFFFF" ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Segoe UI bold" COLOR="#B45309" POINT-SIZE="12"><B>bairro</B></FONT> <FONT FACE="Segoe UI" COLOR="#B45309" POINT-SIZE="8">  atalho</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="id_bairro_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#8A5A00"><B>PK</B></FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B"><B>id_bairro</B></FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="id_bairro_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">int4</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="nome_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">nome</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="nome_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="regiao_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">regiao</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="regiao_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">varchar(10)</FONT></TD></TR></TABLE>>, pos="-1.2,3.2!"];
