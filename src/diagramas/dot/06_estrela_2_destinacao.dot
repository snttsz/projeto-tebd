"dw.dim_veiculo" -> "dw.fato_destinacao" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#12343B", penwidth=1.3, arrowsize=1.1, label=<<FONT POINT-SIZE="10" COLOR="#3A4C50"><I> sk_veiculo </I></FONT>>];
nota [shape=note, style=filled, fillcolor="#FFF7E0", color="#B45309", pos="-9.2,-0.4!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#12343B"><B>Medidas e decisões</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#12343B">peso_kg · aditiva</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#12343B">Dimensões conformes com a Estrela 1:</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#12343B">tempo, tipo de resíduo, rota e veículo</FONT></TD></TR></TABLE>>];
}
