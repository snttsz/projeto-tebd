"funcionario" -> "coleta_equipe" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#12343B", penwidth=1.3, arrowsize=1.1, label=<<FONT POINT-SIZE="10" COLOR="#3A4C50"><I> integra </I></FONT>>];
