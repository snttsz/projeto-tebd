"tipo_residuo" -> "coleta_item" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#12343B", penwidth=1.3, arrowsize=1.1, label=<<FONT POINT-SIZE="10" COLOR="#3A4C50"><I> classifica </I></FONT>>];
"coleta" -> "descarga" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#12343B", penwidth=1.3, arrowsize=1.1, label=<<FONT POINT-SIZE="10" COLOR="#3A4C50"><I> gera </I></FONT>>];
"destino_final" -> "descarga" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#12343B", penwidth=1.3, arrowsize=1.1, label=<<FONT POINT-SIZE="10" COLOR="#3A4C50"><I> recebe </I></FONT>>];
"tipo_residuo" -> "descarga" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#12343B", penwidth=1.3, arrowsize=1.1, label=<<FONT POINT-SIZE="10" COLOR="#3A4C50"><I> classifica </I></FONT>>];
"legA" [shape=box, style="rounded,filled", fillcolor="#2F7D4F14", color="#2F7D4F", penwidth=2, width=2.6, height=0.4, fixedsize=true, fontsize=10, fontcolor="#12343B", label="A · Planejamento e execução", pos="0.0,-7.2!"];
"legB" [shape=box, style="rounded,filled", fillcolor="#2B6CB014", color="#2B6CB0", penwidth=2, width=2.6, height=0.4, fixedsize=true, fontsize=10, fontcolor="#12343B", label="B · Pesagem e destinação", pos="3.0,-7.2!"];
"legC" [shape=box, style="rounded,filled", fillcolor="#B4530914", color="#B45309", penwidth=2, width=2.6, height=0.4, fixedsize=true, fontsize=10, fontcolor="#12343B", label="C · Território e cidadão", pos="6.0,-7.2!"];
