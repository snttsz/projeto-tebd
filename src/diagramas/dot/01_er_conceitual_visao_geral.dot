digraph G { layout=neato; splines=line; overlap=true; pad=0.4;
graph [fontname="Segoe UI", bgcolor="#FFFFFF", pad=0.4, labelloc=t, labeljust=l, fontsize=15, fontcolor="#12343B"];
node [shape=plaintext, fontname="Segoe UI"];
edge [fontname="Segoe UI"];
label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#12343B"><B>Modelo conceitual · visão geral</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4A5B5F">12 entidades em 3 subáreas (cor da borda) · notação pé-de-galinha · atributos nos diagramas das subáreas</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F"><B>PK</B> chave primária  ·  <B>FK</B> chave estrangeira  ·  ? aceita NULL  ·  tracejado = atalho de outra subárea  ·  1 ‖ ○&lt; = um para zero ou muitos  ·  ‖○ = FK opcional</FONT></TD></TR></TABLE>>; labelloc=t; labeljust=l;
"bairro" [shape=box, style="rounded,filled", fillcolor="#B4530914", color="#B45309", penwidth=2, fontcolor="#12343B", fontsize=13, width=1.9, height=0.62, fixedsize=true, label=<<B>bairro</B>>, pos="0,0!"];
"ponto_coleta" [shape=box, style="rounded,filled", fillcolor="#B4530914", color="#B45309", penwidth=2, fontcolor="#12343B", fontsize=13, width=1.9, height=0.62, fixedsize=true, label=<<B>ponto_coleta</B>>, pos="4.2,3.0!"];
"ocorrencia" [shape=box, style="rounded,filled", fillcolor="#B4530914", color="#B45309", penwidth=2, fontcolor="#12343B", fontsize=13, width=1.9, height=0.62, fixedsize=true, label=<<B>ocorrencia</B>>, pos="4.2,0.4!"];
"rota" [shape=box, style="rounded,filled", fillcolor="#2F7D4F14", color="#2F7D4F", penwidth=2, fontcolor="#12343B", fontsize=13, width=1.9, height=0.62, fixedsize=true, label=<<B>rota</B>>, pos="4.2,-2.4!"];
"coleta" [shape=box, style="rounded,filled", fillcolor="#2F7D4F14", color="#2F7D4F", penwidth=2, fontcolor="#12343B", fontsize=13, width=1.9, height=0.62, fixedsize=true, label=<<B>coleta</B>>, pos="8.6,-2.4!"];
"veiculo" [shape=box, style="rounded,filled", fillcolor="#2F7D4F14", color="#2F7D4F", penwidth=2, fontcolor="#12343B", fontsize=13, width=1.9, height=0.62, fixedsize=true, label=<<B>veiculo</B>>, pos="8.6,-4.0!"];
"funcionario" [shape=box, style="rounded,filled", fillcolor="#2F7D4F14", color="#2F7D4F", penwidth=2, fontcolor="#12343B", fontsize=13, width=1.9, height=0.62, fixedsize=true, label=<<B>funcionario</B>>, pos="4.2,-5.4!"];
"coleta_equipe" [shape=box, style="rounded,dashed", fillcolor="#2F7D4F14", color="#2F7D4F", penwidth=2, fontcolor="#12343B", fontsize=13, width=1.9, height=0.62, fixedsize=true, label=<<B>coleta_equipe</B><BR/><FONT POINT-SIZE="8">associativa N:N</FONT>>, pos="13.0,-5.2!"];
"coleta_item" [shape=box, style="rounded,filled", fillcolor="#2B6CB014", color="#2B6CB0", penwidth=2, fontcolor="#12343B", fontsize=13, width=1.9, height=0.62, fixedsize=true, label=<<B>coleta_item</B>>, pos="8.6,1.0!"];
"tipo_residuo" [shape=box, style="rounded,filled", fillcolor="#2B6CB014", color="#2B6CB0", penwidth=2, fontcolor="#12343B", fontsize=13, width=1.9, height=0.62, fixedsize=true, label=<<B>tipo_residuo</B>>, pos="13.0,3.0!"];
"descarga" [shape=box, style="rounded,filled", fillcolor="#2B6CB014", color="#2B6CB0", penwidth=2, fontcolor="#12343B", fontsize=13, width=1.9, height=0.62, fixedsize=true, label=<<B>descarga</B>>, pos="13.0,-0.4!"];
"destino_final" [shape=box, style="rounded,filled", fillcolor="#2B6CB014", color="#2B6CB0", penwidth=2, fontcolor="#12343B", fontsize=13, width=1.9, height=0.62, fixedsize=true, label=<<B>destino_final</B>>, pos="17.4,-0.4!"];
"bairro" -> "ponto_coleta" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#12343B", penwidth=1.3, arrowsize=1.1, label=<<FONT POINT-SIZE="10" COLOR="#3A4C50"><I> contém </I></FONT>>];
"bairro" -> "ocorrencia" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#12343B", penwidth=1.3, arrowsize=1.1, label=<<FONT POINT-SIZE="10" COLOR="#3A4C50"><I> origina </I></FONT>>];
"bairro" -> "rota" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#12343B", penwidth=1.3, arrowsize=1.1, label=<<FONT POINT-SIZE="10" COLOR="#3A4C50"><I> é atendido por </I></FONT>>];
"ponto_coleta" -> "ocorrencia" [dir=both, arrowtail=teeodot, arrowhead=crowodot, color="#12343B", penwidth=1.3, arrowsize=1.1, label=<<FONT POINT-SIZE="10" COLOR="#3A4C50"><I> é citado em </I></FONT>>];
