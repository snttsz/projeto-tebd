"dw.dim_funcionario" [label=<<TABLE BORDER="1" COLOR="#2F7D4F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="3" BGCOLOR="#2F7D4F" ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Segoe UI bold" COLOR="#FFFFFF" POINT-SIZE="12"><B>dim_funcionario</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="sk_funcionario_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#8A5A00"><B>PK</B></FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B"><B>sk_funcionario</B></FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="sk_funcionario_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">int4</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="id_origem_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">id_origem</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="id_origem_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">int4</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="matricula_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">matricula</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="matricula_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="nome_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">nome</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="nome_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="cargo_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">cargo</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="cargo_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">varchar(10)</FONT></TD></TR></TABLE>>, pos="0,-3.4!"];
"dw.dim_tempo" -> "dw.fato_viagem" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#12343B", penwidth=1.3, arrowsize=1.1, label=<<FONT POINT-SIZE="10" COLOR="#3A4C50"><I> sk_tempo </I></FONT>>];
"dw.dim_rota" -> "dw.fato_viagem" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#12343B", penwidth=1.3, arrowsize=1.1, label=<<FONT POINT-SIZE="10" COLOR="#3A4C50"><I> sk_rota </I></FONT>>];
"dw.dim_veiculo" -> "dw.fato_viagem" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#12343B", penwidth=1.3, arrowsize=1.1, label=<<FONT POINT-SIZE="10" COLOR="#3A4C50"><I> sk_veiculo </I></FONT>>];
"dw.dim_funcionario" -> "dw.fato_viagem" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#12343B", penwidth=1.3, arrowsize=1.1, label=<<FONT POINT-SIZE="10" COLOR="#3A4C50"><I> sk_motorista </I></FONT>>];
nota [shape=note, style=filled, fillcolor="#FFF7E0", color="#B45309", pos="-9.4,-0.6!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#12343B"><B>Medidas e decisões</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#12343B">km_percorridos, duracao_min, peso_total_kg, qtd_pontos_atendidos · aditivas</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#12343B">qtd_cancelada · aditiva (0/1): SUM = nº de cancelamentos</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#12343B">km e duração são NULL nas coletas canceladas (não rodaram)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#12343B">Base do dashboard tático: kg/km, kg/h, taxa de cancelamento</FONT></TD></TR></TABLE>>];
}
