digraph G { layout=neato; splines=line; overlap=true; pad=0.4;
graph [fontname="Segoe UI", bgcolor="#FFFFFF", pad=0.4, labelloc=t, labeljust=l, fontsize=15, fontcolor="#12343B"];
node [shape=plaintext, fontname="Segoe UI"];
edge [fontname="Segoe UI"];
label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#12343B"><B>Estrela 4 · Viagem de coleta (produtividade)</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4A5B5F">Cada coleta como uma viagem do veículo: quilômetros, duração, peso total, pontos atendidos e cancelamentos.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F"><B>PK</B> chave primária  ·  <B>FK</B> chave estrangeira  ·  ? aceita NULL  ·  cabeçalho escuro = FATO · verde = DIMENSÃO  ·  1 ‖ ○&lt; = um para zero ou muitos  ·  ‖○ = FK opcional</FONT></TD></TR></TABLE>>; labelloc=t; labeljust=l;
"dw.fato_viagem" [label=<<TABLE BORDER="1" COLOR="#12343B" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="3" BGCOLOR="#12343B" ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Segoe UI bold" COLOR="#FFFFFF" POINT-SIZE="12"><B>fato_viagem</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F1F5F5"><FONT FACE="Segoe UI" POINT-SIZE="8" COLOR="#4A5B5F"><I>GRÃO: uma coleta (viagem de um veículo em uma rota, em uma data), inclusive as canceladas</I></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="id_coleta_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#8A5A00"><B>PK</B></FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B"><B>id_coleta</B></FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="id_coleta_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">int4</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="sk_tempo_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#2B6CB0"><B>FK</B></FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">sk_tempo</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="sk_tempo_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">int4</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="sk_rota_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#2B6CB0"><B>FK</B></FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">sk_rota</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="sk_rota_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">int4</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="sk_veiculo_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#2B6CB0"><B>FK</B></FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">sk_veiculo</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="sk_veiculo_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">int4</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="sk_motorista_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#2B6CB0"><B>FK</B></FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">sk_motorista</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="sk_motorista_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">int4</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="km_percorridos_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">km_percorridos <FONT COLOR="#8A9A9E" POINT-SIZE="8">?</FONT></FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="km_percorridos_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">numeric(7,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="duracao_min_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">duracao_min <FONT COLOR="#8A9A9E" POINT-SIZE="8">?</FONT></FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="duracao_min_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">int4</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="peso_total_kg_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">peso_total_kg</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="peso_total_kg_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">numeric(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="qtd_pontos_atendidos_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">qtd_pontos_atendidos</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="qtd_pontos_atendidos_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">int4</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="qtd_cancelada_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">qtd_cancelada</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="qtd_cancelada_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">int2</FONT></TD></TR></TABLE>>, pos="0,0!"];
"dw.dim_tempo" [label=<<TABLE BORDER="1" COLOR="#2F7D4F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="3" BGCOLOR="#2F7D4F" ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Segoe UI bold" COLOR="#FFFFFF" POINT-SIZE="12"><B>dim_tempo</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="sk_tempo_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#8A5A00"><B>PK</B></FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B"><B>sk_tempo</B></FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="sk_tempo_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">int4</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="data_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">data</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="data_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">date</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="dia_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">dia</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="dia_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">int2</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="mes_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">mes</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="mes_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">int2</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="nome_mes_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">nome_mes</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="nome_mes_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="trimestre_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">trimestre</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="trimestre_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">int2</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="semestre_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">semestre</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="semestre_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">int2</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="ano_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">ano</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="ano_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">int2</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="dia_semana_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">dia_semana</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="dia_semana_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">int2</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="nome_dia_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">nome_dia</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="nome_dia_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">varchar(15)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="fim_de_semana_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">fim_de_semana</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="fim_de_semana_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">bool</FONT></TD></TR></TABLE>>, pos="-5.4,3.9!"];
