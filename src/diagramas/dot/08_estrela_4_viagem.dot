B7F">int2</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="turno_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">turno</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="turno_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">varchar(5)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="extensao_km_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">extensao_km</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="extensao_km_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">numeric(6,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="bairro_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">bairro</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="bairro_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="regiao_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">regiao</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="regiao_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">varchar(10)</FONT></TD></TR></TABLE>>, pos="0,4.9!"];
"dw.dim_veiculo" [label=<<TABLE BORDER="1" COLOR="#2F7D4F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="3" BGCOLOR="#2F7D4F" ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Segoe UI bold" COLOR="#FFFFFF" POINT-SIZE="12"><B>dim_veiculo</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="sk_veiculo_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#8A5A00"><B>PK</B></FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B"><B>sk_veiculo</B></FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="sk_veiculo_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">int4</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="id_origem_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">id_origem</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="id_origem_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">int4</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="placa_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">placa</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="placa_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">char(7)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="tipo_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">tipo</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="tipo_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F">varchar(15)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="28" PORT="capacidade_kg_l"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#FFFFFF">&nbsp;</FONT></TD><TD ALIGN="LEFT" WIDTH="118"><FONT FACE="Segoe UI" POINT-SIZE="10" COLOR="#12343B">capacidade_kg</FONT></TD><TD ALIGN="LEFT" WIDTH="84" PORT="capacidade_kg_r"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6