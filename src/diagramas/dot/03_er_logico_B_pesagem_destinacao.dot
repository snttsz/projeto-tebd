digraph G { layout=neato; splines=line; overlap=true; pad=0.4;
graph [fontname="Segoe UI", bgcolor="#FFFFFF", pad=0.4, labelloc=t, labeljust=l, fontsize=15, fontcolor="#12343B"];
node [shape=plaintext, fontname="Segoe UI"];
edge [fontname="Segoe UI"];
label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#12343B"><B>Subárea B · Pesagem e destinação</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4A5B5F">O que foi pesado em cada ponto, por tipo de resíduo, e para onde foi descarregado.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Consolas" POINT-SIZE="8" COLOR="#6B7B7F"><B>PK</B> chave primária  ·  <B>FK</B> chave estrangeira  ·  ? aceita NULL  ·  tracejado = atalho de outra subárea  ·  1 ‖ ○&lt; = um para zero ou muitos  ·  ‖○ = FK opcional</FONT></TD></TR></TABLE>>; labelloc=t; labeljust=l;
