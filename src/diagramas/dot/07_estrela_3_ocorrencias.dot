"dw.dim_ocorrencia" -> "dw.fato_ocorrencia" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#12343B", penwidth=1.3, arrowsize=1.1, label=<<FONT POINT-SIZE="10" COLOR="#3A4C50"><I> sk_ocorrencia </I></FONT>>];
nota [shape=note, style=filled, fillcolor="#FFF7E0", color="#B45309", pos="-9.2,-1.6!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#12343B"><B>Medidas e decisões</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#12343B">qtd_ocorrencias · aditiva</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#12343B">tempo_resolucao_horas · semiaditiva (usar média, não soma)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#12343B">dim_tempo em 2 papéis: abertura e fechamento</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#12343B">(fechamento NULL = ocorrência em aberto)</FONT></TD></TR></TABLE>>];
