"dw.dim_tempo" -> "dw.fato_ocorrencia" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#12343B", penwidth=1.3, arrowsize=1.1, label=<<FONT POINT-SIZE="10" COLOR="#3A4C50"><I> sk_tempo_abertura </I></FONT>>];
"via_sk_tempo_fechamento" [shape=point, width=0.01, style=invis, pos="-3.7,0.5!"];
