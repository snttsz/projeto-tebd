# Copie este arquivo para ".env" (na raiz do projeto) e ajuste. O ".env" não deve ser compartilhado.
# Valores padrão se nada for definido: localhost, 5432, postgres, senha "postgres".

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=troque_esta_senha
PGDATABASE=cidades_sustentaveis

# Opcionais: caminhos de programas, se não estiverem no PATH nem nas pastas padrão do Windows
# PSQL=C:\Program Files\PostgreSQL\17\bin\psql.exe
# DOT=C:\Program Files\Graphviz\bin\dot.exe
# NAVEGADOR=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
